#####################################################
# Archivo: ~/.dircolors 
# Descripción:  esquema personalizado Nord/Gruvbox
# Autor: Yandri Loor
# Última modificación: 27 Septiembre 2025
#####################################################
COLORTERM ?*
TERM Eterm
TERM ansi
TERM *color*
TERM con[0-9]*x[0-9]*
TERM cons25
TERM console
TERM cygwin
TERM *direct*
TERM dtterm
TERM gnome
TERM hurd
TERM jfbterm
TERM konsole
TERM kterm
TERM linux
TERM linux-c
TERM mlterm
TERM putty
TERM rxvt*
TERM screen*
TERM st
TERM terminator
TERM tmux*
TERM vt100
TERM vt220
TERM xterm*


# Color por defecto
NORMAL 00
FILE 00           # Archivos normales
RESET 0

# Directorios
DIR 01;94         # Azul intenso
LINK 01;36        # Cyan brillante
MULTIHARDLINK 01;36

# Ejecutables
EXEC 01;32        # Verde brillante

# Enlaces simbólicos rotos en rojo (así sabes rápido cuándo algo apunta a nada)
ORPHAN 01;31
MISSING 01;31

#Archivos ejecutables peligrosos (setuid/setgid)
SETUID 37;41
SETGID 30;43
CAPABILITY 30;41

# Archivos de bases de datos
.sql 01;33
.sqlite 01;33
.db 01;33

# Archivos de logs 
.log 01;90   # Gris oscuro

#Archivos de configuración
.conf 01;32
.ini 01;32
.toml 01;32
.yaml 01;32
.yml 01;32

#Archivos de backup
.bak 02;37
.old 02;37
*~   02;37

